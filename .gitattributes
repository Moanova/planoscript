# Normalize line endings to LF in the repository
* text=auto eol=lf

# Source code
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.ico binary
*.qss binary
