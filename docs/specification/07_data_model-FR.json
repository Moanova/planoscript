{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "name": "Planoscript ::: Modèle de données",
   "version": "0.1.0-alpha",
   "description": "Modèle de données des projets Planoscript : projets, cartes narratives, entités et relations.",
   "type": "object",
   "properties": {
      "id": {
         "type": "string",
         "format": "uuid",
         "description": "Identifiant unique du projet"
      },
      "lb": {
         "type": "string",
         "description": "Nom du projet"
      },
      "creation_date_time": {
         "type": "string",
         "format": "date-time",
         "description": "Date et heure de création du projet"
      },
      "modification_date_time": {
         "type": "string",
         "format": "date-time",
         "description": "Date et heure de dernière modification du projet"
      },
      "agent": {
         "type": "array",
         "items": {
            "$ref": "#/$defs/Agent"
         },
         "description": "Agent de la carte narrative"
      },
      "narrative_map": [
         {
            "type": "object",
            "properties": {
               "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Identifiant unique de la carte narrative"
               },
               "lb": {
                  "type": "string",
                  "description": "Nom de la carte narrative"
               },
               "creation_date_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Date et heure de création de la carte narrative"
               },
               "modification_date_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Date et heure de dernière modification de la carte narrative"
               },
               "state": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/State"
                  },
                  "description": "Etat de la carte narrative"
               },
               "event": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/Event"
                  },
                  "description": "Evènement de la carte narrative"
               },
               "journey": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/Journey"
                  },
                  "description": "Parcours de la carte narrative"
               },
               "state_agent_rel": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/State_agent_rel"
                  },
                  "description": "Relation entre état et agent"
               },
               "Journey_node": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/Journey_node"
                  },
                  "description": "Noeud de parcours"
               },
               "event_to_state": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/Event_to_state"
                  },
                  "description": "Arc évènement vers état (relation entrante)"
               },
               "state_to_event": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/State_to_event"
                  },
                  "description": "Arc état vers évènement (relation sortante)"
               }
            },
            "required": []
         }
      ]
   },
   "required": [
      "id",
      "lb",
      "creation_date_time"
   ],
   "$defs": {
      "Agent": {
         "type": "object",
         "category": "entity",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de l'agent"
            },
            "lb": {
               "type": "string",
               "description": "Libellé de l'agent"
            },
            "note": {
               "type": "string",
               "description": "Annotation de l'agent"
            },
            "typ": {
               "type": "string",
               "enum": [
                  "Object",
                  "Subject"
               ],
               "default_value": "Subject",
               "description": "Type de l'agent"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de l'agent"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de l'agent"
            }
         },
         "required": [
            "id",
            "lb",
            "typ",
            "creation_date_time"
         ]
      },
      "State": {
         "type": "object",
         "category": "entity",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de l'état"
            },
            "lb": {
               "type": "string",
               "description": "Libellé de l'état"
            },
            "note": {
               "type": "string",
               "description": "Annotation de l'état"
            },
            "typ": {
               "type": "string",
               "enum": [
                  "Initial",
                  "Action",
                  "Relation",
                  "Final"
               ],
               "default_value": "Action",
               "description": "Type de l'état"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de l'état"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de l'état"
            }
         },
         "required": [
            "id",
            "lb",
            "typ",
            "creation_date_time"
         ]
      },
      "Event": {
         "type": "object",
         "category": "entity",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de l'évènement"
            },
            "lb": {
               "type": "string",
               "description": "Libellé de l'évènement"
            },
            "note": {
               "type": "string",
               "description": "Annotation de l'évènement"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de l'évènement"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de l'évènement"
            }
         },
         "required": [
            "id",
            "lb",
            "creation_date_time"
         ]
      },
      "Journey": {
         "type": "object",
         "category": "entity",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique du parcours"
            },
            "lb": {
               "type": "string",
               "description": "Libellé du parcours"
            },
            "note": {
               "type": "string",
               "description": "Annotation du parcours"
            },
            "default": {
               "type": "boolean",
               "default_value": false,
               "description": "Indicateur de parcours par défaut"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création du parcours"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification du parcours"
            }
         },
         "required": [
            "id",
            "lb",
            "default",
            "creation_date_time"
         ]
      },
      "State_agent_rel": {
         "type": "object",
         "category": "relationship",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de la relation d'état à agent"
            },
            "state_id": {
               "type": "integer",
               "description": "Identifiant unique de l'état (référence à State.id)"
            },
            "agent_id": {
               "type": "integer",
               "description": "Identifiant unique de l'agent (référence à Agent.id)"
            },
            "note": {
               "type": "string",
               "description": "Annotation de la relation d'état à agent"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de la relation d'état à agent"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de la relation d'état à agent"
            }
         },
         "required": [
            "id",
            "state_id",
            "agent_id",
            "creation_date_time"
         ]
      },
      "Journey_node": {
         "type": "object",
         "category": "relationship",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique du noeud de parcours"
            },
            "journey_id": {
               "type": "integer",
               "description": "Identifiant unique du parcours (reference a Journey.id)"
            },
            "sequence_order": {
               "type": "integer",
               "description": "Position ordinale dans la sequence du parcours"
            },
            "event_to_state_id": {
               "type": "integer",
               "description": "Identifiant unique de l'arc entrant (reference a Event_to_state.id) ; null pour l'etat initial"
            },
            "state_to_event_id": {
               "type": "integer",
               "description": "Identifiant unique de l'arc sortant (reference a State_to_event.id) ; null pour l'etat final"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de creation du noeud de parcours"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de derniere modification du noeud de parcours"
            }
         },
         "required": [
            "id",
            "journey_id",
            "sequence_order",
            "creation_date_time"
         ]
      },
      "Event_to_state": {
         "type": "object",
         "category": "relationship",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de l'arc évènement vers état"
            },
            "event_id": {
               "type": "integer",
               "description": "Identifiant unique de l'évènement source (référence à Event.id)"
            },
            "state_id": {
               "type": "integer",
               "description": "Identifiant unique de l'état cible (référence à State.id)"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de l'arc évènement vers état"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de l'arc évènement vers état"
            }
         },
         "required": [
            "id",
            "event_id",
            "state_id",
            "creation_date_time"
         ]
      },
      "State_to_event": {
         "type": "object",
         "category": "relationship",
         "properties": {
            "id": {
               "type": "integer",
               "description": "Identifiant unique de l'arc état vers évènement"
            },
            "state_id": {
               "type": "integer",
               "description": "Identifiant unique de l'état source (référence à State.id)"
            },
            "event_id": {
               "type": "integer",
               "description": "Identifiant unique de l'évènement cible (référence à Event.id)"
            },
            "creation_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de création de l'arc état vers évènement"
            },
            "modification_date_time": {
               "type": "string",
               "format": "date-time",
               "description": "Date et heure de dernière modification de l'arc état vers évènement"
            }
         },
         "required": [
            "id",
            "state_id",
            "event_id",
            "creation_date_time"
         ]
      }
   },
   "cardinalities": [
      {
         "name": "state_agent_rel_card",
         "description": "0 ou n états sont liés à 0 ou n agents",
         "from": "State",
         "to": "Agent",
         "relationship": "State_agent_rel",
         "cardinality": {
            "from": "0..*",
            "to": "0..*"
         },
         "directional_relationship": false
      },
      {
         "name": "state_to_event_card",
         "description": "0 ou n états sont liés à 0 ou n évènements (arc sortant)",
         "from": "State",
         "to": "Event",
         "relationship": "State_to_event",
         "cardinality": {
            "from": "0..*",
            "to": "0..*"
         },
         "directional_relationship": true
      },
      {
         "name": "event_to_state_card",
         "description": "0 ou n évènements sont liés à 0 ou n états (arc entrant)",
         "from": "Event",
         "to": "State",
         "relationship": "Event_to_state",
         "cardinality": {
            "from": "0..*",
            "to": "0..*"
         },
         "directional_relationship": true
      },
      {
         "name": "journey_node_card",
         "description": "0 ou n états sont liés à 0 ou n parcours",
         "from": "State",
         "to": "Journey",
         "relationship": "Journey_node",
         "cardinality": {
            "from": "0..*",
            "to": "0..*"
         },
         "directional_relationship": false
      }
   ],
   "notes": [
      "Les cardinalités suivent cette notation : 0..* (zéro ou plusieurs), 1..* (un ou plusieurs), 0..1 (zéro ou un), 1 (exactement un).",
      "Les relations directionnelles ont une source et une cible.",
      "Les arcs Event_to_state et State_to_event sont indépendants : chaque arc est créé ou supprimé individuellement lors de la création ou suppression d'une relation."
   ]
}